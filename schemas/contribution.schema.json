{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xkumakichi/technocore-safe-agent-ja/blob/main/schemas/contribution.schema.json",
  "title": "Technocore contribution manifest",
  "type": "object",
  "required": [
    "formatVersion",
    "id",
    "name",
    "status",
    "summary",
    "repository",
    "license",
    "identity",
    "capabilities",
    "verification",
    "artifacts",
    "limitations"
  ],
  "properties": {
    "formatVersion": { "const": "1" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "status": { "enum": ["working-prototype", "stable", "archived"] },
    "summary": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "format": "uri" },
    "license": { "type": "string", "minLength": 1 },
    "languages": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "keywords": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "contributionTypes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "identity": {
      "type": "object",
      "required": ["did", "method", "keyType", "publicMetadata"]
    },
    "problems": { "type": "array", "items": { "type": "string" } },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "claim", "evidence"]
      }
    },
    "verification": {
      "type": "object",
      "required": ["runtime", "thirdPartyRuntimeDependencies", "commands", "guide"]
    },
    "artifacts": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "limitations": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  },
  "additionalProperties": true
}
